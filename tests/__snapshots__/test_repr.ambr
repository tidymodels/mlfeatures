# name: TestSelectorRepr.test_composite_and_complement
  dict({
    'and': "select(role='predictor') & select(type=NumericType)",
    'complement': "~select(role='predictor')",
    'or': "select(role='predictor') | select(type=NumericType)",
  })
# ---
# name: TestSelectorRepr.test_name_selectors
  dict({
    'col': "col('a', 'b')",
    'contains': "contains('z')",
    'ends_with': "ends_with('_id')",
    'matches': "matches('^x')",
    'starts_with': "starts_with('x')",
  })
# ---
# name: TestSelectorRepr.test_role_and_type_selectors
  dict({
    'everything': 'everything()',
    'nominal': 'select(type=(String, Categorical, Enum))',
    'numeric_predictors': "select(role='predictor', type=NumericType)",
    'predictors': "select(role='predictor')",
  })
# ---
# name: TestSelectorRepr.test_source_selectors
  dict({
    'has_ancestor': 'has_ancestor(step_type=StepDummy)',
    'has_source': "has_source('dummy')",
  })
# ---
# name: TestStepRepr.test_intercept_consumes_no_columns
  'step_intercept()  [untrained]'
# ---
# name: TestStepRepr.test_trained_empty_selection
  'step_normalize(<empty selection>)  [trained]'
# ---
# name: TestStepRepr.test_trained_shows_produced_columns
  'step_dummy(city → city_NYC, city_SF)  [trained]'
# ---
# name: TestStepRepr.test_trained_shows_resolved_columns
  'step_normalize(age)  [trained]'
# ---
# name: TestStepRepr.test_untrained_list_selector
  "step_dummy(['city'])  [untrained]"
